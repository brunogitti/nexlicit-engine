LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Nome do modelo no formato usado pela API (não o nome de marketing). Confirmado
# em 2026-07 na documentação oficial (ai.google.dev/gemini-api/docs/models) e
# na tela do Google AI Studio como o Flash disponível no free tier.
GEMINI_MODEL=gemini-3.6-flash
DATABASE_PATH=./nexlicit.db
UPLOAD_DIR=./uploads

# NEXLICIT_USE_BANCO_REAL: trava estrutural (app/db/conexao.py) contra
# conectar no banco real por acidente (ex.: script de verificação sem
# caminho_banco explícito). NÃO defina isto aqui no .env — .env é
# carregado por QUALQUER script rodado nesta pasta, então isso viraria
# ambiente pra tudo, inclusive os scripts avulsos que a trava existe pra
# barrar. Pra rodar o servidor de verdade contra o banco real, defina na
# hora, só naquele comando:
#   NEXLICIT_USE_BANCO_REAL=1 uvicorn app.main:app --reload

# Uso futuro (Claude como alternativa ao Gemini)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
