LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Nome do modelo no formato usado pela API (não o nome de marketing). Confirmado
# em 2026-07 na documentação oficial (ai.google.dev/gemini-api/docs/models) e
# na tela do Google AI Studio como o Flash disponível no free tier.
GEMINI_MODEL=gemini-3.6-flash
DATABASE_PATH=./nexlicit.db
UPLOAD_DIR=./uploads

# Uso futuro (Claude como alternativa ao Gemini)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
