# Segredos e configuração local — nunca vai pro repositório público.
.env

# Banco de dados local (SQLite).
*.db

# Exceção: demo.db não tem dado real nenhum -- é gerado por
# demo/edital_ficticio/gerar_demo_db.py a partir do edital fictício da
# mesma pasta, e é o banco fixo que a instância pública (modo estático)
# usa pra não depender de chamada de IA em tempo de execução. Qualquer
# outro *.db continua bloqueado por padrão pela regra acima.
!demo/edital_ficticio/demo.db

# Arquivos enviados pelos usuários pela própria aplicação.
uploads/

# Log de auditoria da limpeza automática de processos antigos (16/08/2026,
# app/limpeza.py) -- registra nome/órgão de processo real removido, mesmo
# motivo de uploads/ e *.db ficarem fora do Git.
logs/

# Pasta de convenção para guardar editais reais fora da pasta uploads/,
# por exemplo durante testes manuais. Nunca deve ir pro Git.
editais-reais/

# Arquivos gerados pelo Python.
__pycache__/
*.pyc

# Ambientes virtuais.
venv/
.venv/
